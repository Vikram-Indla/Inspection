// Fill with the same project values used by apps/web (.env). Do NOT commit real keys.
// Real values go in the gitignored Secrets.local.xcconfig, which overrides these placeholders.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Optional local override (gitignored) — present on dev machines with real creds.
#include? "Secrets.local.xcconfig"
