# SAQEEL / MIM Inspection — web environment template.
# Copy to .env.local and fill in. NEVER commit real secrets to this file.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_server_side_only

# --- Mapbox ----------------------------------------------------------------
# Public browser token for Mapbox GL JS. Restrict it in Mapbox to approved web
# origins before configuring a shared environment. Never commit a real token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_restricted_public_mapbox_token

# Server-side Mapbox Directions token. Use a dedicated least-privilege token
# where available; it is intentionally not exposed to the browser bundle.
MAPBOX_ACCESS_TOKEN=replace_with_server_side_mapbox_token

# --- Google Gemini (optional governed AI briefings only) -------------------
# Marker is the only OCR provider for evidence extraction. It is configured
# separately through MARKER_OCR_WORKER_URL and MARKER_OCR_WORKER_TOKEN.
# Either name works; the _INSPECTION suffix takes precedence.
GEMINI_API_KEY_INSPECTION=replace_with_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# --- Resend (email delivery) ----------------------------------------------
# Either name works; the _INSPECTION suffix takes precedence.
RESEND_API_KEY_INSPECTION=replace_with_resend_api_key
# Must be a verified sending domain, otherwise Resend rejects the send.
RESEND_FROM="SAQEEL Inspection <no-reply@your-verified-domain>"

# --- Twilio ----------------------------------------------------------------
# SMS needs the account SID + auth token + a purchased sending number.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=+10000000000
# Video needs an API Key pair; the account auth token cannot sign an
# AccessToken. Server-side only — never prefix these with NEXT_PUBLIC_.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace_with_twilio_api_key_secret

# --- Web Push (VAPID) ------------------------------------------------------
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT=mailto:no-reply@your-verified-domain
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# --- Feature gates ---------------------------------------------------------
# Shipped "off"; each page refuses to render until its gate is "on".
FEATURE_AI_DOCKETS=on
FEATURE_CASE_SPINE=on
FEATURE_DECISION_DOSSIER=on
FEATURE_EXCEPTION_BOARD=on
FEATURE_EXTERNAL_PORTAL=on
FEATURE_OCR_REVIEW=on
FEATURE_RISK_WORKBENCH=on
FEATURE_SPATIAL_CANVAS=on
FEATURE_TASKS_WORKSPACE=on
FEATURE_WORKFLOW_TRANSITION=on
FEATURE_M2_05_EVENT_ADAPTER=shared

# Set to "true" only where decide_enforcement_recommendation and
# issue_bulk_violation are actually deployed to the target database.
ENFORCEMENT_P0_RPCS_DEPLOYED=true

# --- Non-production stubs (leave off when the real providers are wired) -----
# FEATURE_MEDIA_FIXTURES=off
# FEATURE_FACTORY_RISK_FIXTURES=off
# FEATURE_NOTIFICATION_STUBS=off
# NEXT_PUBLIC_FEATURE_VIDEO_PROVIDER=off
# NEXT_PUBLIC_FEATURE_LOCATION_SOURCE=device
