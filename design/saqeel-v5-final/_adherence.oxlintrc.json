{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/domain/**",
              "components/icons/**",
              "components/overlays/**",
              "components/patterns2/**",
              "components/process/**",
              "components/status/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Arabic|Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Arabic, Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|className|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminFilterToolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:search|chips|end|className|key|ref|className|style|children)$/]",
        "message": "<AdminFilterToolbar> doesn't accept that prop. Declared props: search, chips, end, className."
