{
 "_": [
  "Figma component -> React component. This is what turns a picture into something a",
  "developer can build: without it, 'use the Panel' means searching the repo and guessing.",
  "",
  "`figma` is the component (or component-set) name exactly as it appears in the file.",
  "`react` is the import path under apps/web/src/components/saqeel/, or null when the Figma",
  "node is a layout primitive with no component of its own — those are marked `kind`:",
  "  'component' — a real React component, import it",
  "  'composed'  — build it from the listed parts; no single component exists",
  "  'content'   — a per-screen content block, not a reusable component",
  "  'icon'      — an icon; see apps/web/src/components/saqeel/icons",
  "",
  "Verified against the 56 .tsx files under components/saqeel on 2026-08-01."
 ],

 "App sidebar":       { "react": "navigation/Sidebar",            "kind": "component" },
 "App sidebar — Administration expanded": {
                       "react": "navigation/Sidebar",             "kind": "component",
                       "note": "same component; the admin group is expanded via its own state, not a variant" },
 "App topbar":        { "react": "navigation/TopBar",             "kind": "component" },
 "Brand lockup":      { "react": "navigation/TopBar",             "kind": "composed",
                       "note": "rendered by Sidebar/TopBar; see SaqeelBrandMark for the mark itself" },
 "Brand mark":        { "react": "SaqeelBrandMark",               "kind": "component",
                       "note": "apps/web/src/components/SaqeelBrandMark.tsx, not under saqeel/" },
 "nav-item":          { "react": "navigation/Sidebar",            "kind": "composed",
                       "note": "an item inside Sidebar; not exported separately" },

 "Button":            { "react": "actions/Button",                "kind": "component" },
 "Input":             { "react": "inputs/Input",                  "kind": "component" },
 "Select":            { "react": "inputs/Select",                 "kind": "component" },
 "Field":             { "react": "inputs/Field",                  "kind": "component" },
 "seg-opt":           { "react": "inputs/SegmentedControl",       "kind": "composed",
                       "note": "one option within SegmentedControl" },
 "filter-chip":       { "react": "navigation/FilterBar",          "kind": "composed" },

 "Badge":             { "react": "data/StatusBadge",              "kind": "component",
                       "note": "status is text plus shape, never colour alone — CLAUDE.md rule 6" },
 "Panel":             { "react": null,                            "kind": "composed",
                       "note": "the .panel class in saqeel-components.css; a div, not a component" },
 "KPI panel":         { "react": "data/KPICard",                  "kind": "component" },
 "stat":              { "react": "data/MetricStrip",              "kind": "composed" },
 "Accordion header":  { "react": "data/Accordion",                "kind": "component" },
 "DetailRow":         { "react": "data/DetailRow",                "kind": "component" },
 "Table cell":        { "react": "grid/DataGrid",                 "kind": "composed",
                       "note": "cells come from DataGrid columns; there is no standalone cell component" },
 "section-title":     { "react": null,                            "kind": "composed",
                       "note": "the .section-title class; a heading element" },

 "Alert":             { "react": "feedback/Alert",                "kind": "component",
                       "note": "Kind variants map to the appearance prop" },
 "ad-state":          { "react": "feedback/StateSurface",         "kind": "component" },
 "empty":             { "react": "feedback/EmptyState",           "kind": "component" },
 "saqeel-state--loading":      { "react": "feedback/Skeleton",    "kind": "component" },
 "saqeel-state--unauthorized": { "react": "feedback/StateSurface","kind": "component",
                       "note": "StateSurface with the unauthorized kind" },
 "saqeel-state--rls-denied":   { "react": "feedback/StateSurface","kind": "component" },
 "saqeel-state--not-yet":      { "react": "feedback/StateSurface","kind": "component" },

 "InspectionCard":    { "react": "inspection/InspectionCard",     "kind": "component" },
 "Factory card":      { "react": "inspection/InspectionCard",     "kind": "component",
                       "note": "same card, factory variant" },
 "ReviewPanel":       { "react": "inspection/ReviewPanel",        "kind": "component" },
 "FindingCard":       { "react": "inspection/FindingCard",        "kind": "component" },
 "EvidenceCard":      { "react": "inspection/EvidenceCard",       "kind": "component" },
 "EvidenceStack row": { "react": "signature/EvidenceStack",       "kind": "composed",
                       "note": "one row of EvidenceStack" },
 "DiffView":          { "react": "feedback/DiffView",             "kind": "component" },
 "diff-row":          { "react": "feedback/DiffView",             "kind": "composed",
                       "note": "a row inside DiffView; a frame, not its own component" },
 "SeverityIndicator": { "react": "inspection/SeverityIndicator",  "kind": "component" },
 "DueDate":           { "react": "inspection/DueDate",            "kind": "component" },
 "ChecklistQuestion": { "react": "inspection/ChecklistQuestion",  "kind": "component" },
 "ComplianceScore":   { "react": "inspection/ComplianceScore",    "kind": "component" },
 "SyncIndicator":     { "react": "feedback/SyncIndicator",        "kind": "component" },
 "GeoWorkspace":      { "react": "signature/GeoWorkspace",        "kind": "component" },
 "ExceptionMark":     { "react": "signature/ExceptionRail",       "kind": "composed" },

 "icon/nav/dashboard":   { "react": null, "kind": "icon" },
 "icon/nav/radar":       { "react": null, "kind": "icon" },
 "icon/nav/factory":     { "react": null, "kind": "icon" },
 "icon/nav/calendar":    { "react": null, "kind": "icon" },
 "icon/nav/inspect":     { "react": null, "kind": "icon" },
 "icon/nav/review":      { "react": null, "kind": "icon" },
 "icon/nav/library":     { "react": null, "kind": "icon" },
 "icon/nav/enforcement": { "react": null, "kind": "icon" },
 "icon/nav/ai":          { "react": null, "kind": "icon" },
 "icon/nav/admin":       { "react": null, "kind": "icon" },
 "icon/ui/bell":         { "react": null, "kind": "icon" },

 "_panel_content": [
  "Every `panel-content/*` component is a per-screen content block, not a reusable",
  "component. They exist so one Panel instance can carry different content while staying",
  "a Panel. Build them as page-level JSX inside the route, not as shared components.",
  "The name after the slash is screen + region, e.g. panel-content/factory-360-compliance",
  "is the Compliance region of Factory 360."
 ],

 "_react_components_not_placed_on_any_screen": [
  "These exist in the repo and appear on no screen frame. Either the screen that needs them",
  "is unbuilt, or the component is unused — resolve before treating the file as complete:",
  "actions/ButtonGroup, data/Avatar, data/DescriptionList, data/Tag, data/Timeline,",
  "feedback/Drawer, feedback/Menu, feedback/Modal, feedback/Toast, feedback/Tooltip,",
  "inputs/Choice, inputs/Combobox, inputs/DateRangePicker, inputs/FileUpload,",
  "inputs/StatusSelector, inspection/AuditTrail, map/MapMarker, map/MapPanel,",
  "map/MapToolbar, navigation/Breadcrumb, navigation/ColumnManager,",
  "navigation/CommandPalette, navigation/UserMenu, signature/ExceptionRail,",
  "signature/StatusSpine",
  "",
  "Modal, Drawer, Toast and Tooltip are overlays and would not appear in a static screen",
  "frame even if used — they need their own frames before a developer can match them."
 ]
}
